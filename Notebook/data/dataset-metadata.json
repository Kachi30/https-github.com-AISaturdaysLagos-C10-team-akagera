{
  "title": "Agriculture & Climate SLM Benchmark",
  "id": "YOUR_KAGGLE_USERNAME/agriculture-climate-slm",
  "subtitle": "Fine-tune a small LM for farmer extension and climate adaptation Q&A",
  "description": "24-document synthetic ag/climate corpus with train QA pairs. Submit short answers for test questions. Scored by mean Levenshtein distance (lower is better). Complements RAG retrieval track #9.",
  "licenses": [{ "name": "CC-BY-4.0" }],
  "keywords": ["agriculture", "climate", "slm", "fine-tuning", "extension", "smallholders"],
  "resources": [
    {
      "path": "documents.csv",
      "description": "24 extension factsheets for fine-tuning.",
      "schema": {
        "fields": [
          { "name": "document_id", "type": "string" },
          { "name": "title", "type": "string" },
          { "name": "text", "type": "string" },
          { "name": "topic", "type": "string" },
          { "name": "crop", "type": "string" },
          { "name": "agro_zone", "type": "string" },
          { "name": "origin", "type": "string" },
          { "name": "source_url", "type": "string" },
          { "name": "license", "type": "string" }
        ]
      }
    },
    {
      "path": "train_qa.csv",
      "description": "45 training question-answer pairs.",
      "schema": {
        "fields": [
          { "name": "QuestionId", "type": "integer" },
          { "name": "question", "type": "string" },
          { "name": "topic", "type": "string" },
          { "name": "crop", "type": "string" },
          { "name": "agro_zone", "type": "string" },
          { "name": "document_id", "type": "string" },
          { "name": "reference_answer", "type": "string" }
        ]
      }
    },
    {
      "path": "test_questions.csv",
      "description": "12 test questions without answers.",
      "schema": {
        "fields": [
          { "name": "QuestionId", "type": "integer" },
          { "name": "question", "type": "string" },
          { "name": "topic", "type": "string" },
          { "name": "crop", "type": "string" },
          { "name": "agro_zone", "type": "string" }
        ]
      }
    },
    {
      "path": "sample_submission.csv",
      "schema": {
        "fields": [
          { "name": "QuestionId", "type": "integer" },
          { "name": "Answer", "type": "string" }
        ]
      }
    },
    { "path": "baseline_submission.csv", "description": "Topic-filtered retrieval baseline." },
    { "path": "DATACARD.md", "description": "Full documentation." }
  ]
}
